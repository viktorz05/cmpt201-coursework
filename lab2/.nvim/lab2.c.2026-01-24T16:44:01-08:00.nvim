#define _POSIX_C_SOURCE 200809L
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <sys/types.h>
#include <sys/wait.h>
#include <unistd.h>

int main() {
  char *buf = NULL;
  size_t len = 0;
  ssize_t read;
  while (1) {
    printf("Enter programs to run.\n> ");
    if ((read = getline(&buf, &len, stdin)) == -1) {
      perror("Failed to read line!\n");
    } else {
      if (len > 0 && buf[len -1] == '\n') {
        buf[len - 1] = '\0';
      }
      pid_t pid = fork();
      if (pid < 0) {
        perror("fork() failed!\n");
        continue;
      }
      else if (pid > 0) {
        int wstatus = 0;
        if (waitpid(pid, &wstatus, 0) == -1) {
          perror("waitpid");
          exit(EXIT_FAILURE);
        }
        if (WIFEXITED(wstatus)) {
          printf("Child exited.\n");
        }
      } else {
         if (execl(buf, buf, (char *)NULL) == -1) {
            perror("execl");
            free(buf);
            exit(EXIT_FAILURE);
          }
        }
      }
    }
  return 0;
}

