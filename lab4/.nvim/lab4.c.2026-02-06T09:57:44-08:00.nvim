#include <stdio.h>
#include <stdint.h>
#include <errno.h>
#include <unistd.h>
#include <stdlib.h>

struct header {
  uint64_t size;
  struct header* next;
};

void* increase_heap_size(__intptr_t size) {

  void *address = sbrk(size);
  if (address == -1) {
    perror("sbrk() failed\n");
    return NULL;
  }
  return address;
}

