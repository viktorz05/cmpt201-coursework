#define _POSIX_C_SOURCE 200809L
#include "string.h"
#include "stdio.h"
#include "stdlib.h"

int main() {
  char *buf = NULL;
  size_t len = 0;
  ssize_t read;
  printf("Please enter some text: ");
  if (read = getline(&buf, &len, stdin) != -1) {
    printf("Tokens:\n");
    char* tok = NULL;
    char* saveptr = NULL;
    char* str = buf;
    while ((tok = strtok_r(buf, " ", &saveptr))) {
      printf("%s\n", tok);
    }
  }
  free(buf);

  return 0;
}
