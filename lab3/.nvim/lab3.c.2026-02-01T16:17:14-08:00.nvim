#define _GNU_SOURCE
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

#define MAX_SIZE 5

char *read_input() {

  char *line = NULL;
  ssize_t read;
  size_t len = 0;

  printf("Enter input:");
  if ((read = getline(&line, &len, stdin)) == -1) {
    perror("getline failed!\n");
  } else if (read > 0 && line[read - 1] == '\n') {
    line[read - 1] = '\0';
  } else {
    exit(1);
  }
  return line;
}

void store_history() {}

int main() {
  char history[MAX_SIZE] = {0};
  while (1) {
    char *input = read_input();
  }
  return 0;
}
