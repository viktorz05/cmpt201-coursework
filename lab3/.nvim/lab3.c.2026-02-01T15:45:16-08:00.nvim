#define _GNU_SOURCE
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

#define MAX_SIZE 5

char *read_input() {

  char *line = NULL;
  ssize_t read;
  size_t len = 0;

  if ((read = getline(&line, &len, stdin)) != -1) {
    printf("Enter input:");
  }
  else if (read > 0 && line[len - 1] == '\n') {
    line[len - 1] = '\0';
  }
  else {
    perror("getline failed!\n");
    exit(1);
  }
  return line;
}
